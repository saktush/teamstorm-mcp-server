# TeamStorm API Configuration
TEAMSTORM_API_URL=http://teamstorm.local/cwm/public/api/v1
# TEAMSTORM_API_TOKEN is optional in HTTP mode — each client passes its own token via Authorization header
# TEAMSTORM_API_TOKEN=your_private_token_here

# Optional: which toolsets to load per session. Comma-separated list or a keyword.
# Toolsets: tasks, documents, portfolios, planning, structure, reference (reference is always on).
# Keywords: "all" (default — all 80 tools) | "default" (tasks,structure,reference).
# Per-session override: ?toolsets=tasks,documents in the MCP URL, or X-TeamStorm-Toolsets header.
# TEAMSTORM_TOOLSETS=all

# Server Configuration
PORT=3001
NODE_ENV=production

# Listen host. Default: 127.0.0.1 when TEAMSTORM_API_TOKEN is set (prevents anonymous remote sessions),
# 0.0.0.0 otherwise. Override explicitly for container/network deployments with a server token.
# LISTEN_HOST=0.0.0.0

# Optional: trust X-Forwarded-For header (enable only behind a reverse proxy)
# TRUST_PROXY=false

# Tool-call observability.
# TEAMSTORM_TOOL_TIMEOUT_MS: after this long a tool call is abandoned and returns a
# structured error instead of hanging. Default 60000 — deliberately 2x the 30s axios
# timeout, so a single clean API round trip can never trip it. The abandoned call keeps
# running and logs its true duration ("tool.orphaned"), which is how you identify a hang.
# TEAMSTORM_TOOL_TIMEOUT_MS=60000
# TEAMSTORM_SLOW_TOOL_MS: calls slower than this are logged as "tool.slow". Default 5000.
# TEAMSTORM_SLOW_TOOL_MS=5000